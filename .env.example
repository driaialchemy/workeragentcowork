# Local environment template for workeragentcowork.
# Copy this file to .env and fill in real values locally.
# Never commit .env.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_ARTICLES_PER_SOURCE=2
MAX_TOTAL_ARTICLES=0

# Optional email settings. Leave blank to skip email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_TO=
